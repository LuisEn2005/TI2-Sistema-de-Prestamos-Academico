---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props { titulo: string; acceso?: boolean }
const { titulo, acceso = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Préstamos Académicos</title>
  </head>
  <body class:list={{ 'pagina-acceso': acceso, 'pagina-aplicacion': !acceso }}>
    {acceso ? (
      <header class="cabecera-acceso">
        <a class="marca marca-acceso" href="/">Préstamos Académicos</a>
        <a class="enlace-catalogo" href="/catalogo">Consultar catálogo</a>
      </header>
    ) : (
      <aside class="barra-lateral">
        <a id="marca" class="marca" href="/catalogo">Préstamos Académicos</a>
        <p class="institucion">Escuela de Ciencia de la Computación</p>
        <div id="zona-espacio" class="zona-espacio"></div>
        <nav id="navegacion" aria-label="Principal"></nav>
        <div id="zona-sesion" class="sesion"></div>
      </aside>
    )}
    <main class:list={{ 'contenido-acceso': acceso, 'contenido-aplicacion': !acceso }}>
      <p id="mensaje" class="mensaje" role="status" aria-live="polite"></p>
      <slot />
    </main>
    <script>
      import '../compartido/sesion.ts';
    </script>
  </body>
</html>

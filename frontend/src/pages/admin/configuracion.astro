---
import Base from '../../layouts/Base.astro';
---

<Base titulo="Configuración">
  <div class="encabezado-pagina">
    <h1>Configuración del servicio</h1>
    <p>Edite solamente los límites, plazos y sanciones que aplica el sistema.</p>
  </div>

  <h2>Modalidades</h2>
  <div class="tabla-envoltura"><table>
    <thead><tr><th>Modalidad</th><th>Activa</th><th>Acción</th></tr></thead>
    <tbody id="modalidades"></tbody>
  </table></div>

  <h2 class="seccion-separada">Reglas compartidas por perfil</h2>
  <div class="tabla-envoltura"><table>
    <thead><tr><th>Perfil</th><th>Cupo compartido</th><th>Sanción por día de atraso</th><th>Acción</th></tr></thead>
    <tbody id="politicas-rol"></tbody>
  </table></div>

  <h2 class="seccion-separada">Plazos por perfil y modalidad</h2>
  <div class="tabla-envoltura"><table>
    <thead><tr><th>Perfil</th><th>Modalidad</th><th>Días de préstamo</th><th>Acción</th></tr></thead>
    <tbody id="politicas"></tbody>
  </table></div>
  <p class="tenue pequeno">Los cambios se aplican a las operaciones nuevas. Los préstamos existentes conservan el plazo que recibieron.</p>

  <h2 class="seccion-separada">Días no laborables</h2>
  <form id="formulario-cierre" class="barra panel filtros-operativos">
    <div><label for="cierre-inicio">Desde</label><input id="cierre-inicio" type="date" required /></div>
    <div><label for="cierre-fin">Hasta</label><input id="cierre-fin" type="date" required /></div>
    <div><label for="cierre-tipo">Tipo</label><select id="cierre-tipo">
      <option value="FERIADO">Feriado</option><option value="HUELGA">Huelga</option>
      <option value="OTRO">Otro</option>
    </select></div>
    <div><label for="cierre-motivo">Motivo</label><input id="cierre-motivo" maxlength="200" required /></div>
    <button id="guardar-cierre" type="submit">Registrar cierre</button>
    <button id="cancelar-edicion-cierre" type="button" class="secundario" hidden>Cancelar edición</button>
  </form>
  <p class="tenue pequeno">Los vencimientos afectados se aplazan y las reservas confirmadas pasan al siguiente rango libre. Desactivar un cierre no revierte fechas ya comunicadas.</p>
  <div class="tabla-envoltura"><table>
    <thead><tr><th>Rango</th><th>Tipo</th><th>Motivo</th><th>Estado</th><th>Acción</th></tr></thead>
    <tbody id="cierres"></tbody>
  </table></div>
  <script>import '../../funcionalidades/configuracion.ts';</script>
</Base>

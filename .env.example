# Copia este archivo a .env (en la raíz) y ajusta los valores:  cp .env.example .env
# .env está en .gitignore: nunca se sube. Lo leen tanto el backend como Astro.
# Las variables ya definidas en el sistema operativo tienen prioridad (override=False).

# --- Base de datos ---
# Vacío = SQLite local en backend/instance/prestamos.sqlite (suficiente para desarrollo).
# Postgres: postgresql+psycopg://usuario:clave@localhost:5432/prestamos
DATABASE_URL=

# --- Datos de demostración ---
# 1 = carga usuarios y 26 recursos de ejemplo (idempotente). 0 = base limpia para uso real.
DATOS_DEMO=1

# --- Seguridad / sesión ---
# Clave para firmar los tokens. Para uso real genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Administrador inicial (solo necesario con DATOS_DEMO=0) ---
ADMIN_CORREO=
ADMIN_PASSWORD=

# --- Zona horaria (por defecto America/Lima) ---
ZONA_HORARIA=America/Lima

# --- Frontend: destino del proxy /api de Astro (por defecto http://127.0.0.1:5000) ---
API_PROXY_TARGET=http://127.0.0.1:5000
